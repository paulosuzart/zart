"""Type stubs for the native ``zart._zart`` PyO3 extension module."""

from collections.abc import Awaitable, Callable
from typing import Any

class ZartControlFlowSignal(BaseException):
    """Internal control-flow signal for Zart step scheduling and replay."""

class ZartError(Exception):
    """Base exception for Zart durable execution errors."""

class ZartStepFailedError(ZartError):
    """Raised when a required step fails with a business or framework error."""

class ZartRetryExhaustedError(ZartError):
    """Raised when a step exhausts all configured retry attempts."""

class ZartStepTimeoutError(ZartError):
    """Raised when a step exceeds its configured timeout."""

class ZartDeadlineExceededError(ZartError):
    """Raised when a step or event deadline is exceeded."""

class Trx:
    """Zart-managed step transaction handle."""

    async def execute(self, sql: str, *args: Any) -> int: ...
    async def fetch_one(self, sql: str, *args: Any) -> dict[str, Any]: ...
    async def fetch_optional(self, sql: str, *args: Any) -> dict[str, Any] | None: ...
    async def fetch_all(self, sql: str, *args: Any) -> list[dict[str, Any]]: ...

class ClientTrx:
    """Caller-managed PostgreSQL transaction handle."""

    async def execute(self, sql: str, *args: Any) -> int: ...
    async def fetch_one(self, sql: str, *args: Any) -> dict[str, Any]: ...
    async def fetch_optional(self, sql: str, *args: Any) -> dict[str, Any] | None: ...
    async def fetch_all(self, sql: str, *args: Any) -> list[dict[str, Any]]: ...
    async def commit(self) -> None: ...
    async def rollback(self) -> None: ...
    async def __aenter__(self) -> ClientTrx: ...
    async def __aexit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        tb: Any,
    ) -> bool: ...

class PgBackend:
    """PostgreSQL-backed storage and scheduler entry point for Zart."""

    @staticmethod
    async def connect(url: str, listener_url: str | None = None) -> PgBackend: ...
    def with_listener_url(self, url: str) -> PgBackend: ...
    async def begin(self) -> ClientTrx: ...
    async def run_migrations(self) -> None: ...
    async def close(self) -> None: ...

class ScheduleResult:
    """Result returned when scheduling a durable execution."""

    @property
    def task_id(self) -> str: ...
    @property
    def execution_time(self) -> str: ...
    def __repr__(self) -> str: ...

class ExecutionRecord:
    """Snapshot of a durable execution record."""

    @property
    def execution_id(self) -> str: ...
    @property
    def task_name(self) -> str: ...
    @property
    def payload(self) -> Any: ...
    @property
    def status(self) -> str: ...
    @property
    def result(self) -> Any | None: ...
    @property
    def scheduled_at(self) -> str: ...
    @property
    def completed_at(self) -> str | None: ...
    @property
    def version(self) -> int: ...
    def __repr__(self) -> str: ...

class DurableScheduler:
    """Control-plane client for starting, querying, and awaiting durable executions."""

    def __init__(self, backend: PgBackend) -> None: ...
    async def start(
        self,
        execution_id: str,
        task_name: str,
        payload: Any,
    ) -> ScheduleResult: ...
    async def start_in_tx(
        self,
        tx: ClientTrx,
        execution_id: str,
        task_name: str,
        payload: Any,
    ) -> ScheduleResult: ...
    async def status(self, execution_id: str) -> ExecutionRecord: ...
    async def wait(
        self,
        execution_id: str,
        timeout_secs: float = 30.0,
        poll_interval_secs: float | None = None,
    ) -> ExecutionRecord: ...
    async def wait_completion(
        self,
        execution_id: str,
        timeout_secs: float = 30.0,
        poll_interval_secs: float | None = None,
    ) -> Any: ...
    async def cancel(self, execution_id: str) -> bool: ...
    async def offer_event(
        self,
        execution_id: str,
        event_name: str,
        payload: Any,
    ) -> None: ...

class RetryPolicy:
    """Retry configuration for a durable step."""

    @staticmethod
    def none() -> RetryPolicy: ...
    @staticmethod
    def fixed(attempts: int, delay_secs: float) -> RetryPolicy: ...
    @staticmethod
    def exponential(
        attempts: int,
        initial_delay_secs: float,
        max_delay_secs: float | None = None,
        multiplier: float = 2.0,
    ) -> RetryPolicy: ...
    @staticmethod
    def linear(
        attempts: int,
        initial_delay_secs: float,
        max_delay_secs: float | None = None,
    ) -> RetryPolicy: ...
    @property
    def max_attempts(self) -> int: ...
    @property
    def initial_delay_secs(self) -> float: ...
    @property
    def backoff_multiplier(self) -> float: ...
    @property
    def max_delay_secs(self) -> float | None: ...
    def __repr__(self) -> str: ...

class StepSpec:
    """A step invocation specification created by ``@step``."""

    def __init__(
        self,
        name: str,
        callable: Callable[..., Awaitable[Any]],
        retry: RetryPolicy | None = None,
        timeout_secs: float | None = None,
        timeout_scope: str | None = None,
        inject_trx: bool = False,
    ) -> None: ...
    def named(self, id: str) -> StepSpec: ...
    @property
    def name(self) -> str: ...
    def __repr__(self) -> str: ...

class ExecutionFailure:
    """Description of why ``on_failure`` was invoked on a ``DurableTask``."""

    @property
    def kind(self) -> str: ...
    @property
    def step(self) -> str | None: ...
    @property
    def raw(self) -> Any | None: ...
    @property
    def attempts(self) -> int | None: ...
    def __repr__(self) -> str: ...

class DurableTask:
    """A durable workflow handler registered with ``WorkerBuilder.register_durable``."""

    def __init__(
        self,
        name: str,
        handler: Callable[[Any], Awaitable[Any]],
        timeout_secs: float | None = None,
        max_retries: int = 0,
        on_failure: Callable[[Any, ExecutionFailure], Awaitable[Any]] | None = None,
    ) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def max_retries(self) -> int: ...
    @property
    def timeout_secs(self) -> float | None: ...
    def __repr__(self) -> str: ...

class ExecutionInfo:
    """Metadata about the currently running durable execution."""

    @property
    def execution_id(self) -> str: ...
    @property
    def task_name(self) -> str: ...
    @property
    def data(self) -> Any: ...
    @property
    def current_attempt(self) -> int: ...
    @property
    def max_retries(self) -> int | None: ...
    def is_retry(self) -> bool: ...
    def __repr__(self) -> str: ...

class StepOutcome:
    """Outcome of executing a step via ``step`` or ``wait``."""

    @property
    def kind(self) -> str: ...
    @property
    def is_ok(self) -> bool: ...
    @property
    def is_business_err(self) -> bool: ...
    @property
    def is_zart_err(self) -> bool: ...
    @property
    def value(self) -> Any | None: ...
    @property
    def error(self) -> Any | None: ...
    def unwrap(self) -> Any: ...
    def __repr__(self) -> str: ...

class StepHandle:
    """Handle to a scheduled parallel step."""

    @property
    def step_name(self) -> str: ...
    def __repr__(self) -> str: ...

class WorkerBuilder:
    """Builder for configuring and constructing a Zart ``Worker``."""

    def __init__(self, backend: PgBackend) -> None: ...
    def register_durable(self, task: DurableTask) -> WorkerBuilder: ...
    def trx_provider(self, provider: Any) -> WorkerBuilder: ...
    def poll_interval(self, secs: float) -> WorkerBuilder: ...
    def max_concurrent_tasks(self, max_tasks: int) -> WorkerBuilder: ...
    def max_tasks_per_poll(self, max_tasks: int) -> WorkerBuilder: ...
    def shutdown_timeout(self, secs: float) -> WorkerBuilder: ...
    def orphan_timeout(self, secs: float) -> WorkerBuilder: ...
    def enable_listen_notify(self, enabled: bool) -> WorkerBuilder: ...
    def build(self) -> Worker: ...

class Worker:
    """Polls the task queue and dispatches tasks to registered handlers."""

    async def run(self) -> None: ...
    def stop(self) -> None: ...

async def require(step: StepSpec) -> Any: ...
async def step(step: StepSpec) -> StepOutcome: ...
async def step_or(step: StepSpec, default: Any) -> Any: ...
async def step_or_else(step: StepSpec, fallback: Callable[[Any], Any]) -> Any: ...
