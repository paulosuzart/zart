class DurableScheduler:
    """Control-plane client for starting, querying, and awaiting durable executions."""

    def __init__(self, backend: PgBackend) -> None: ...
    async def start(
        self,
        execution_id: str,
        task_name: str,
        payload: Any,
    ) -> ScheduleResult: ...
    async def start_in_tx(
        self,
        tx: ClientTrx,
        execution_id: str,
        task_name: str,
        payload: Any,
    ) -> ScheduleResult: ...
    async def status(self, execution_id: str) -> ExecutionRecord: ...
    async def wait(
        self,
        execution_id: str,
        timeout_secs: float = 30.0,
        poll_interval_secs: float | None = None,
    ) -> ExecutionRecord: ...
    async def wait_completion(
        self,
        execution_id: str,
        timeout_secs: float = 30.0,
        poll_interval_secs: float | None = None,
    ) -> Any: ...
    async def cancel(self, execution_id: str) -> bool: ...
    async def offer_event(
        self,
        execution_id: str,
        event_name: str,
        payload: Any,
    ) -> None: ...
    async def stop_recurring(self, task_id: str) -> None: ...
    async def list_executions(
        self,
        params: ListExecutionsParams | None = None,
    ) -> list[ExecutionRecord]: ...
    async def stats(self) -> ExecutionStats: ...
    async def get_current_run_id(self, execution_id: str) -> str | None: ...
    async def list_runs(self, execution_id: str) -> list[ExecutionRunRecord]: ...
    async def execution_detail(
        self,
        execution_id: str,
        run_id: str | None = None,
    ) -> ExecutionDetail: ...
    async def retry_step(
        self,
        run_id: str,
        step_name: str,
        triggered_by: str | None = None,
    ) -> str: ...
    async def retry_step_current_run(
        self,
        execution_id: str,
        step_name: str,
        triggered_by: str | None = None,
    ) -> str: ...
    async def restart(
        self,
        execution_id: str,
        new_payload: Any = None,
        triggered_by: str | None = None,
    ) -> str: ...
    async def rerun_steps(
        self,
        execution_id: str,
        spec: RerunSpec | None = None,
    ) -> RerunResult: ...
    async def pause(self, scope: PauseScope) -> PauseRule: ...
    async def resume(
        self,
        scope: PauseScope,
        deleted_by: str | None = None,
    ) -> ResumeResult: ...
    async def resume_rule_by_id(
        self,
        rule_id: str,
        deleted_by: str | None = None,
    ) -> ResumeResult: ...
    async def list_pause_rules(
        self,
        filter: PauseRuleFilter | None = None,
    ) -> list[PauseRule]: ...

class OverlapPolicy:
    """Policy controlling how overlapping occurrences of a recurring execution are handled."""

    SkipIfRunning: OverlapPolicy
    CancelAndRestart: OverlapPolicy
    AlwaysStart: OverlapPolicy
    skip_if_running: OverlapPolicy
    cancel_and_restart: OverlapPolicy
    always_start: OverlapPolicy
    def __eq__(self, other: object) -> bool: ...
    def __repr__(self) -> str: ...

class Recurrence:
