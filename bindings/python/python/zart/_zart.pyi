async def wait_for_event(name: str, timeout_secs: float | None = None) -> Any: ...
async def capture(name: str, func: Callable[[], Any]) -> Any: ...
async def now(name: str) -> str: ...
def context() -> ExecutionInfo: ...
def _get_worker_trx_provider() -> Any | None: ...
def _roundtrip_json(obj: Any) -> Any: ...
