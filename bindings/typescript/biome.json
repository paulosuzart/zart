{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"root": false,
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/node_modules",
			"!**/target",
			"!index.js",
			"!index.d.ts",
			"!**/*.node"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 110
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				"noNonNullAssertion": "off"
			},
			"complexity": {
				"noStaticOnlyClass": "off"
			},
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	}
}
