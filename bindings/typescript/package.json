{
  "name": "@zart/effect",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:native": "napi build --platform --release",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example:transactions": "npm run build && node --experimental-strip-types examples/transactions.ts",
    "example:approval": "npm run build && node --experimental-strip-types examples/approval_workflow.ts"
  },
  "napi": {
    "name": "zart-ts",
    "binaryName": "zart-ts"
  },
  "dependencies": {
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
