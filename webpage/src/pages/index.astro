<section class="section">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Failure-First Primitives</span>
      <h2 class="section-title">Everything durable execution needs.</h2>
      <p class="section-sub">
        Built for production Rust services. Every primitive is deterministic, inspectable in SQL, and engineered to survive partial failures by default.
      </p>
    </div>

    <div class="matrix-grid">
      <!-- 01: State Recovery -->
      <article class="matrix-cell">
        <div class="cell-topbar">
          <span>01 // CHECKPOINT REPLAY</span>
          <span class="cell-status"><span class="status-dot green"></span> deterministic</span>
        </div>
        <div class="telemetry-stage stage-replay" aria-hidden="true">
          <div class="replay-track">
            <div class="r-node cached">
              <span class="r-id">01 CACHED</span>
              <span class="r-lbl">validate</span>
            </div>
            <div class="r-node cached">
              <span class="r-id">02 CACHED</span>
              <span class="r-lbl">charge</span>
            </div>
            <div class="r-node fault">
              <span class="r-id">03 RESUME</span>
              <span class="r-lbl">receipt</span>
            </div>
            <div class="r-node resume">
              <span class="r-id">04 NEXT</span>
              <span class="r-lbl">notify</span>
            </div>
          </div>
          <div class="replay-bar"><div class="replay-beam"></div></div>
          <div class="replay-log">
            <span>PG replay: steps 1–2 skipped</span>
            <span class="hl">resume @ step 3</span>
          </div>
        </div>
        <div class="cell-body">
          <h3 class="cell-title">State Recovery</h3>
          <p class="cell-desc">
            Every step commits its serialized output before the next runs. On restart, completed steps replay straight from storage — never re-executed.
          </p>
          <div class="cell-callout">Crash at 3am? Resume from step 4, not step 1.</div>
        </div>
      </article>

      <!-- 02: Smart Retries -->
      <article class="matrix-cell">
        <div class="cell-topbar">
          <span>02 // BACKOFF POLICY</span>
          <span class="cell-status"><span class="status-dot amber"></span> jittered</span>
        </div>
        <div class="telemetry-stage stage-retries" aria-hidden="true">
          <div class="backoff-bars">
            <div class="b-col">
              <div class="b-meter">503</div>
              <div class="b-cap"><span>try 1</span><span>0s</span></div>
            </div>
            <div class="b-col">
              <div class="b-meter">wait 1s</div>
              <div class="b-cap"><span>try 2</span><span>1s</span></div>
            </div>
            <div class="b-col">
              <div class="b-meter">wait 2s</div>
              <div class="b-cap"><span>try 3</span><span>3s</span></div>
            </div>
            <div class="b-col">
              <div class="b-meter">200 OK</div>
              <div class="b-cap"><span>pass</span><span>7s</span></div>
            </div>
          </div>
          <div class="backoff-axis">
            <span>exponential(3, 1s)</span>
            <span>per-step config</span>
          </div>
        </div>
        <div class="cell-body">
          <h3 class="cell-title">Smart Retries</h3>
          <p class="cell-desc">
            Per-step retry policies with fixed, linear, or exponential backoff. Configure max attempts, base delay, and jitter independently on each step.
          </p>
          <div class="cell-callout">Transient network blip? Self-heals before anyone notices.</div>
        </div>
      </article>

      <!-- 03: Concurrent Workers -->
      <article class="matrix-cell">
        <div class="cell-topbar">
          <span>03 // WORKER DISPATCH</span>
          <span class="cell-status"><span class="status-dot green"></span> lock-free</span>
        </div>
        <div class="telemetry-stage stage-workers" aria-hidden="true">
          <div class="worker-lane">
            <span class="w-name">worker_01</span>
            <div class="w-rail"><div class="w-job">job#8a2</div></div>
            <span class="w-state">CLAIMED</span>
          </div>
          <div class="worker-lane">
            <span class="w-name">worker_02</span>
            <div class="w-rail"><div class="w-job">job#8a3</div></div>
            <span class="w-state">CLAIMED</span>
          </div>
          <div class="worker-lane">
            <span class="w-name">worker_03</span>
            <div class="w-rail"><div class="w-job">job#8a4</div></div>
            <span class="w-state">CLAIMED</span>
          </div>
        </div>
        <div class="cell-body">
          <h3 class="cell-title">Concurrent Workers</h3>
          <p class="cell-desc">
            Workers claim tasks across replicas using PostgreSQL <code>SKIP LOCKED</code> — zero lock contention, zero leader election, horizontal scaling out of the box.
          </p>
          <div class="cell-callout">Add more replicas. No config, no coordinator, no drama.</div>
        </div>
      </article>

      <!-- 04: Timeouts & Deadlines -->
      <article class="matrix-cell">
        <div class="cell-topbar">
          <span>04 // HARD DEADLINES</span>
          <span class="cell-status"><span class="status-dot"></span> bounded</span>
        </div>
        <div class="telemetry-stage stage-timeout" aria-hidden="true">
          <div class="timeout-meta">
            <span>exec_ttl = 10m</span>
            <span class="cap">cutoff @ 10:00</span>
          </div>
          <div class="timeout-rail">
            <div class="timeout-threshold"></div>
            <div class="timeout-fill"></div>
          </div>
          <div class="timeout-footer">
            <span>0 leaked connections</span>
            <span class="timeout-badge">CANCELLED CLEANLY</span>
          </div>
        </div>
        <div class="cell-body">
          <h3 class="cell-title">Timeouts &amp; Deadlines</h3>
          <p class="cell-desc">
            Declare execution deadlines right on the handler attribute. Workflows exceeding their budget cancel cleanly with zero orphaned tasks.
          </p>
          <div class="cell-callout">No zombie tasks eating DB connections at 100% CPU.</div>
        </div>
      </article>

      <!-- 05: Idempotency Built-in -->
      <article class="matrix-cell">
        <div class="cell-topbar">
          <span>05 // IDEMPOTENCY KEY</span>
          <span class="cell-status"><span class="status-dot green"></span> unique index</span>
        </div>
        <div class="telemetry-stage stage-idempotency" aria-hidden="true">
          <div class="idem-row">
            <div class="idem-req">key: ord_9f2a</div>
            <span class="idem-gate">UNIQUE</span>
            <div class="idem-res exec">EXECUTED · $49</div>
          </div>
          <div class="idem-row">
            <div class="idem-req">key: ord_9f2a</div>
            <span class="idem-gate">CONFLICT</span>
            <div class="idem-res dedup">DEDUPED · CACHED</div>
          </div>
        </div>
        <div class="cell-body">
          <h3 class="cell-title">Idempotency Built-in</h3>
          <p class="cell-desc">
            Deterministic execution IDs prevent duplicate scheduling at the storage layer. A payment step that succeeded never fires twice — even under duplicate triggers.
          </p>
          <div class="cell-callout">Double-charge bug in prod? That's a chargeback. Not anymore.</div>
        </div>
      </article>

      <!-- 06: Events & Async Waits -->
      <article class="matrix-cell">
        <div class="cell-topbar">
          <span>06 // DURABLE SIGNALS</span>
          <span class="cell-status"><span class="status-dot amber"></span> event-driven</span>
        </div>
        <div class="telemetry-stage stage-events" aria-hidden="true">
          <div class="event-chain">
            <div class="ev-box">01 start</div>
            <div class="ev-box wait">02 suspend</div>
            <div class="ev-box resumed">03 resume</div>
          </div>
          <div class="ev-webhook">
            <span>signal("approved")</span>
            <span>0 CPU while waiting</span>
          </div>
        </div>
        <div class="cell-body">
          <h3 class="cell-title">Events &amp; Async Waits</h3>
          <p class="cell-desc">
            Suspend workflows durably while waiting on webhooks, human approvals, or external services — consuming zero worker threads until signaled.
          </p>
          <div class="cell-callout">Pause 3 days for human approval. Resume in milliseconds.</div>
        </div>
      </article>
    </div>
  </div>
</section>

