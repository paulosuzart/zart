<script>
  // ── Mobile nav toggle ────────────────────────────────────
  const navToggle = document.getElementById('nav-toggle');
  const navLinks  = document.getElementById('nav-links');
  navToggle?.addEventListener('click', () => {
    const open = navLinks?.classList.toggle('open') ?? false;
    navToggle.setAttribute('aria-expanded', String(open));
  });
  navLinks?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      navLinks.classList.remove('open');
      navToggle?.setAttribute('aria-expanded', 'false');
    });
  });

  // ── Copy cargo add zart ──────────────────────────────────
  const copyCargoBtn = document.getElementById('copy-cargo-btn');
  copyCargoBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('cargo add zart');
      copyCargoBtn.textContent = 'Copied';
      copyCargoBtn.classList.add('copied');
      setTimeout(() => {
        copyCargoBtn.textContent = 'Copy';
        copyCargoBtn.classList.remove('copied');
      }, 1800);
    } catch {
      copyCargoBtn.textContent = 'cargo add zart';
    }
  });

  // ── Code section tabs ────────────────────────────────────
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tabId = btn.getAttribute('data-tab');
      if (!tabId) return;
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      document.getElementById('tab-' + tabId)?.classList.add('active');
    });
  });

  // ── Interactive Hero Domain Switcher + Auto-rotation ─────
  const DOMAINS = [
    { id: 'agents',     word: 'Agents',      file: 'brewery_finder.rs' },
    { id: 'payments',   word: 'Payments',    file: 'checkout_flow.rs' },
    { id: 'onboarding', word: 'Onboardings', file: 'onboarding.rs' },
  ];

  let currentIdx = 0;
  let autoTimer = null;
  const wordEl = document.getElementById('hero-word');
  const fileEl = document.getElementById('hero-filename');

  function setDomain(idx, animateWord = true) {
    const next = DOMAINS[idx];
    if (!next) return;
    currentIdx = idx;

    document.querySelectorAll('.domain-btn').forEach(btn => {
      const isMatch = btn.getAttribute('data-domain') === next.id;
      btn.classList.toggle('active', isMatch);
      btn.setAttribute('aria-selected', String(isMatch));
    });

    document.querySelectorAll('.hero-sub-variant, .hero-code-variant, .trace-variant').forEach(el => {
      el.classList.toggle('active', el.getAttribute('data-variant') === next.id);
    });

    if (fileEl) fileEl.textContent = next.file;

    if (!wordEl) return;
    if (!animateWord) {
      wordEl.textContent = next.word;
      return;
    }

    wordEl.classList.add('exiting');
    setTimeout(() => {
      wordEl.textContent = next.word;
      wordEl.classList.remove('exiting');
      wordEl.classList.add('entering');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          wordEl.classList.remove('entering');
        });
      });
    }, 200);
  }

  function startAutoRotate() {
    if (autoTimer) clearInterval(autoTimer);
    autoTimer = setInterval(() => {
      setDomain((currentIdx + 1) % DOMAINS.length, true);
    }, 6500);
  }

  document.querySelectorAll('.domain-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-domain');
      const idx = DOMAINS.findIndex(d => d.id === targetId);
      if (idx !== -1) {
        setDomain(idx, idx !== currentIdx);
        // Pause automatic cycling after manual selection so user can read calmly
        if (autoTimer) {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      }
    });
  });

  startAutoRotate();
</script>

