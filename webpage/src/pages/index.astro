<!-- ── Hero ── -->
<section class="hero">
  <div class="container">
    <div class="hero-inner">
      <div class="hero-text">
        <div class="hero-eyebrow">
          <span class="eyebrow-bar" aria-hidden="true"></span>
          <span>Durable Execution · Rust + PostgreSQL</span>
        </div>

        <div class="domain-switcher" role="tablist" aria-label="Workflow domains">
          <button class="domain-btn active" role="tab" aria-selected="true" data-domain="agents">
            <span class="idx">01</span> Agents
          </button>
          <button class="domain-btn" role="tab" aria-selected="false" data-domain="payments">
            <span class="idx">02</span> Payments
          </button>
          <button class="domain-btn" role="tab" aria-selected="false" data-domain="onboarding">
            <span class="idx">03</span> Onboarding
          </button>
        </div>

        <h1>
          <span id="hero-word">Agents</span> that<br />
          <span class="accent-line">survive failure.</span>
        </h1>

        <div class="hero-sub-stack">
          <p class="hero-sub-variant active" data-variant="agents">
            Give Rust AI agents durable execution out of the box. Every LLM call and tool result is checkpointed to PostgreSQL before advancing — crashes, rate limits, and deploys resume from the last completed step.
          </p>
          <p class="hero-sub-variant" data-variant="payments">
            Build payment flows where every step commits its output before moving on. A charge that succeeded is never executed twice — completed steps replay straight from storage after any crash.
          </p>
          <p class="hero-sub-variant" data-variant="onboarding">
            Orchestrate multi-day onboarding pipelines — welcome emails, billing setup, async human verification — with zero lost state and zero duplicate side effects on restart.
          </p>
        </div>

        <div class="hero-controls">
          <div class="install-bar">
            <span><span class="install-prompt">$</span> cargo add zart</span>
            <button class="copy-cmd-btn" id="copy-cargo-btn" type="button" aria-label="Copy cargo add command">Copy</button>
          </div>

          <div class="hero-actions">
