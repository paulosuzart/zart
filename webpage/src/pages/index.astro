---
// Zart Landing Page — custom marketing page, not a Starlight doc page
import { ZART_VERSION } from "../lib/version";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Zart — Durable Execution for Rust</title>
  <meta name="description" content="Durable execution for Rust. Write workflows that automatically persist every step to PostgreSQL, survive process restarts, and never re-run completed work." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :focus-visible {
      outline: 2px solid var(--brand-bright);
      outline-offset: 2px;
    }

    :root {
      --bg:            oklch(10% 0.012 275);
      --bg-panel:      oklch(13.5% 0.014 275);
      --bg-elevated:   oklch(16.5% 0.016 275);
      --bg-code:       oklch(8.5% 0.012 275);

      --border:        oklch(23% 0.016 275);
      --border-strong: oklch(33% 0.024 275);
      --border-subtle: oklch(18% 0.012 275);

      --text:          oklch(95% 0.006 275);
      --text-muted:    oklch(68% 0.014 275);
      --text-faint:    oklch(48% 0.014 275);

      --brand:         oklch(66% 0.22 282);
      --brand-bright:  oklch(78% 0.16 282);
      --brand-surface: oklch(22% 0.07 282 / 0.45);

      --emerald:       oklch(73% 0.16 156);
      --emerald-dim:   oklch(24% 0.06 156 / 0.5);
      --amber:         oklch(78% 0.15 72);
      --amber-dim:     oklch(25% 0.06 72 / 0.5);
      --crimson:       oklch(65% 0.20 25);
      --crimson-dim:   oklch(23% 0.07 25 / 0.5);

      --font-display:  'Space Grotesk', system-ui, sans-serif;
      --font-sans:     'IBM Plex Sans', system-ui, sans-serif;
      --font-mono:     'JetBrains Mono', ui-monospace, monospace;

      --radius-xs:     3px;
      --radius-sm:     6px;
      --radius-md:     8px;

      --max-w:         1220px;
      --ease-out:      cubic-bezier(0.16, 1, 0.3, 1);
    }

    html {
      scroll-behavior: smooth;
      color-scheme: dark;
      overflow-x: hidden;
    }

    body {
      font-family: var(--font-sans);
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
      position: relative;
    }

    /* Architectural grid backdrop */
    .grid-backdrop {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background-image:
        linear-gradient(to right, oklch(100% 0 0 / 0.028) 1px, transparent 1px),
        linear-gradient(to bottom, oklch(100% 0 0 / 0.028) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: radial-gradient(ellipse 85% 65% at 50% 12%, black 20%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 85% 65% at 50% 12%, black 20%, transparent 100%);
    }

    .container {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 1.5rem;
      position: relative;
      z-index: 1;
    }

    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 2px; }

    /* ────────────────────────────────────────
       NAV
    ──────────────────────────────────────── */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 1px solid var(--border);
      background: oklch(10% 0.012 275 / 0.86);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 62px;
      gap: 1rem;
    }

    .nav-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .nav-logo {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      text-decoration: none;
      color: var(--text);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.05rem;
      letter-spacing: -0.02em;
    }

    .logo-mark {
      width: 28px;
      height: 28px;
      border-radius: var(--radius-xs);
      background: var(--bg-panel);
      border: 1px solid var(--border-strong);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      flex-shrink: 0;
      transition: border-color 0.2s var(--ease-out);
    }

    .nav-logo:hover .logo-mark {
      border-color: var(--brand);
    }

    .version-tag {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      color: var(--text-muted);
      border: 1px solid var(--border);
      background: var(--bg-panel);
      padding: 0.14rem 0.45rem;
      border-radius: var(--radius-xs);
      letter-spacing: 0.02em;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      list-style: none;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 500;
      padding: 0.4rem 0.75rem;
      border-radius: var(--radius-xs);
      transition: color 0.15s, background 0.15s;
    }

    .nav-links a:hover {
      color: var(--text);
      background: var(--bg-elevated);
    }

    .nav-cta {
      margin-left: 0.5rem;
      background: var(--text) !important;
      color: var(--bg) !important;
      font-weight: 600 !important;
      padding: 0.42rem 0.9rem !important;
      border-radius: var(--radius-xs) !important;
      transition: opacity 0.15s, transform 0.15s !important;
    }

    .nav-cta:hover {
      opacity: 0.9;
      background: var(--text) !important;
    }

    .nav-hamburger {
      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      background: none;
      border: 1px solid var(--border);
      cursor: pointer;
      padding: 0.45rem;
      border-radius: var(--radius-xs);
    }

    .nav-hamburger span {
      display: block;
      width: 18px;
      height: 1.5px;
      background: var(--text-muted);
      transition: transform 0.2s, opacity 0.2s;
    }

    @media (max-width: 700px) {
      .nav-hamburger { display: flex; }
      .nav-links {
        display: none;
        position: absolute;
        top: 62px;
        left: 0;
        right: 0;
        flex-direction: column;
        background: var(--bg-panel);
        border-bottom: 1px solid var(--border);
        padding: 0.75rem 1.5rem 1rem;
        gap: 0.25rem;
      }
      .nav-links.open { display: flex; }
      .nav-links li { width: 100%; }
      .nav-links a { display: block; padding: 0.6rem 0.5rem; }
      .nav-cta { margin-left: 0; margin-top: 0.35rem; text-align: center; }
    }

    /* ────────────────────────────────────────
       HERO
    ──────────────────────────────────────── */
    .hero {
      padding: 4.5rem 0 4rem;
      position: relative;
      border-bottom: 1px solid var(--border);
    }

    .hero::before {
      content: '';
      position: absolute;
      top: -120px;
      left: 50%;
      transform: translateX(-50%);
      width: 960px;
      height: 460px;
      background: radial-gradient(ellipse at center, oklch(66% 0.22 282 / 0.14) 0%, transparent 68%);
      pointer-events: none;
      z-index: 0;
    }

    .hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
      gap: 3.5rem;
      align-items: center;
    }

    @media (max-width: 980px) {
      .hero { padding: 3rem 0 3rem; }
      .hero-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--brand-bright);
      margin-bottom: 1.25rem;
    }

    .eyebrow-bar {
      width: 18px;
      height: 1px;
      background: var(--brand);
    }

    /* Interactive domain selector */
    .domain-switcher {
      display: inline-flex;
      border: 1px solid var(--border);
      background: var(--bg-panel);
      border-radius: var(--radius-xs);
      padding: 2px;
      margin-bottom: 1.5rem;
      gap: 2px;
    }

    .domain-btn {
      background: transparent;
      border: none;
      color: var(--text-faint);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 500;
      padding: 0.34rem 0.7rem;
      border-radius: 2px;
      cursor: pointer;
      transition: color 0.15s, background 0.15s;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }

    .domain-btn:hover {
      color: var(--text-muted);
    }

    .domain-btn.active {
      background: var(--bg-elevated);
      color: var(--text);
      box-shadow: inset 0 0 0 1px var(--border-strong);
    }

    .domain-btn .idx {
      color: var(--brand-bright);
      opacity: 0.8;
    }

    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(2.55rem, 4.8vw, 3.85rem);
      font-weight: 700;
      line-height: 1.04;
      letter-spacing: -0.04em;
      color: var(--text);
      margin-bottom: 1.25rem;
    }

    .hero h1 .accent-line {
      display: inline-block;
      color: var(--brand-bright);
      position: relative;
    }

    #hero-word {
      display: inline-block;
      transition: opacity 0.22s var(--ease-out), transform 0.22s var(--ease-out);
    }
    #hero-word.exiting { opacity: 0; transform: translateY(-8px); }
    #hero-word.entering { opacity: 0; transform: translateY(8px); }

    .hero-sub-stack {
      display: grid;
      margin-bottom: 1.75rem;
    }

    .hero-sub-variant {
      grid-area: 1 / 1;
      font-size: 1.04rem;
      color: var(--text-muted);
      line-height: 1.65;
      max-width: 48ch;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.28s var(--ease-out);
      pointer-events: none;
    }

    .hero-sub-variant.active {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    /* Install snippet + CTA row */
    .hero-controls {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }

    .install-bar {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      background: var(--bg-code);
      border: 1px solid var(--border);
      border-radius: var(--radius-xs);
      padding: 0.55rem 0.65rem 0.55rem 0.9rem;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: var(--text);
      max-width: 100%;
    }

    .install-prompt {
      color: var(--brand-bright);
      user-select: none;
    }

    .copy-cmd-btn {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      padding: 0.25rem 0.55rem;
      border-radius: 2px;
      cursor: pointer;
      transition: color 0.15s, border-color 0.15s, background 0.15s;
    }

    .copy-cmd-btn:hover {
      color: var(--text);
      border-color: var(--border-strong);
    }

    .copy-cmd-btn.copied {
      color: var(--emerald);
      border-color: oklch(73% 0.16 156 / 0.45);
      background: var(--emerald-dim);
    }

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-sans);
      font-size: 0.9rem;
      font-weight: 600;
      padding: 0.68rem 1.25rem;
      border-radius: var(--radius-xs);
      text-decoration: none;
      transition: background 0.15s, border-color 0.15s, color 0.15s, transform 0.15s var(--ease-out);
      cursor: pointer;
      border: 1px solid transparent;
    }

    .btn-primary {
      background: var(--brand);
      color: oklch(98% 0.005 282);
      border-color: oklch(72% 0.20 282);
    }

    .btn-primary:hover {
      background: oklch(70% 0.22 282);
      transform: translateY(-1px);
    }

    .btn-ghost {
      background: var(--bg-panel);
      color: var(--text-muted);
      border-color: var(--border);
    }

    .btn-ghost:hover {
      color: var(--text);
      border-color: var(--border-strong);
      background: var(--bg-elevated);
    }

    /* ── Hero Code + Live Trace Console ── */
    .hero-console {
      border: 1px solid var(--border);
      background: var(--bg-code);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: 0 24px 60px oklch(0% 0 0 / 0.55);
    }

    .console-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.6rem 1rem;
      background: var(--bg-panel);
      border-bottom: 1px solid var(--border);
      font-family: var(--font-mono);
      font-size: 0.74rem;
      gap: 0.75rem;
    }

    .console-file {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text);
      font-weight: 500;
    }

    .console-file::before {
      content: '';
      width: 7px;
      height: 7px;
      border-radius: 1px;
      background: var(--brand);
    }

    .console-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-faint);
    }

    .console-badge {
      font-size: 0.68rem;
      color: var(--emerald);
      border: 1px solid oklch(73% 0.16 156 / 0.3);
      background: var(--emerald-dim);
      padding: 0.12rem 0.45rem;
      border-radius: 2px;
    }

    .hero-code-stack {
      display: grid;
      min-width: 0;
    }

    .hero-code-variant {
      grid-area: 1 / 1;
      min-width: 0;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.28s var(--ease-out);
    }

    .hero-code-variant.active {
      opacity: 1;
      pointer-events: auto;
      z-index: 1;
    }

    .hero-code-variant pre {
      padding: 1.15rem 1.25rem;
      overflow-x: auto;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      line-height: 1.65;
      tab-size: 2;
      min-height: calc(19 * 1.65em + 2.3rem);
    }

    /* Live Checkpoint Trace strip below hero code */
    .trace-strip {
      border-top: 1px solid var(--border);
      background: oklch(11% 0.012 275);
      padding: 0.75rem 1.1rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
    }

    .trace-strip-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: var(--text-faint);
      margin-bottom: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-size: 0.65rem;
    }

    .trace-rows {
      display: grid;
    }

    .trace-variant {
      grid-area: 1 / 1;
      display: flex;
      flex-direction: column;
      gap: 0.32rem;
      opacity: 0;
      transition: opacity 0.25s var(--ease-out);
      pointer-events: none;
    }

    .trace-variant.active {
      opacity: 1;
      pointer-events: auto;
    }

    .trace-line {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .trace-tag {
      font-size: 0.65rem;
      padding: 0.05rem 0.35rem;
      border-radius: 2px;
      flex-shrink: 0;
      font-weight: 600;
    }

    .tag-ok   { color: var(--emerald); background: var(--emerald-dim); }
    .tag-warn { color: var(--crimson); background: var(--crimson-dim); }
    .tag-pg   { color: var(--brand-bright); background: var(--brand-surface); }

    /* Syntax tokens (high-contrast obsidian palette) */
    .kw   { color: oklch(74% 0.18 282); font-weight: 500; }
    .mac  { color: oklch(76% 0.16 32);  font-weight: 500; }
    .str  { color: oklch(75% 0.14 152); }
    .cmt  { color: oklch(52% 0.015 275); font-style: italic; }
    .ty   { color: oklch(80% 0.12 215); }
    .fn   { color: oklch(82% 0.14 78); }
    .attr { color: oklch(74% 0.15 315); }
    .lit  { color: oklch(78% 0.15 55); }

    /* ────────────────────────────────────────
       SPEC STRIP (PILLARS — ZERO EMOJIS)
    ──────────────────────────────────────── */
    .spec-strip {
      border-bottom: 1px solid var(--border);
      background: var(--bg-panel);
    }

    .spec-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }

    .spec-item {
      padding: 2rem 2rem;
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      transition: background 0.2s var(--ease-out);
    }

    .spec-item:last-child { border-right: none; }
    .spec-item:hover { background: var(--bg-elevated); }

    .spec-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      color: var(--brand-bright);
    }

    .spec-title {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--text);
      letter-spacing: -0.02em;
    }

    .spec-desc {
      font-size: 0.875rem;
      color: var(--text-muted);
      line-height: 1.55;
    }

    @media (max-width: 820px) {
      .spec-grid { grid-template-columns: 1fr; }
      .spec-item {
        border-right: none;
        border-bottom: 1px solid var(--border);
        padding: 1.5rem 0;
      }
      .spec-item:last-child { border-bottom: none; }
    }

    /* ────────────────────────────────────────
       FEATURES MATRIX (6 PRECISION TELEMETRY PANELS)
    ──────────────────────────────────────── */
    .section {
      padding: 6rem 0;
    }

    .section-header {
      max-width: 44rem;
      margin-bottom: 3rem;
    }

    .section-label {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 500;
      color: var(--brand-bright);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.75rem;
    }

    .section-title {
      font-family: var(--font-display);
      font-size: clamp(1.9rem, 3.6vw, 2.7rem);
      font-weight: 700;
      letter-spacing: -0.035em;
      line-height: 1.1;
      color: var(--text);
      margin-bottom: 0.85rem;
    }

    .section-sub {
      font-size: 1rem;
      color: var(--text-muted);
      line-height: 1.65;
    }

    /* Flush 1px architectural matrix */
    .matrix-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border: 1px solid var(--border);
      background: var(--border);
      gap: 1px;
    }

    @media (max-width: 1024px) {
      .matrix-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 660px) {
      .matrix-grid { grid-template-columns: minmax(0, 1fr); }
    }

    .matrix-cell {
      background: var(--bg);
      display: flex;
      flex-direction: column;
      transition: background 0.2s var(--ease-out);
    }

    .matrix-cell:hover {
      background: var(--bg-panel);
    }

    .cell-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.65rem 1.25rem;
      border-bottom: 1px solid var(--border-subtle);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.06em;
      color: var(--text-faint);
    }

    .cell-status {
      color: var(--text-muted);
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }

    .status-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--brand);
    }

    .status-dot.green { background: var(--emerald); }
    .status-dot.amber { background: var(--amber); }

    /* Fixed-height telemetry stage: NEVER stretches or jumps */
    .telemetry-stage {
      height: 152px;
      padding: 1rem 1.25rem;
      background: var(--bg-code);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .cell-body {
      padding: 1.35rem 1.25rem 1.5rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .cell-title {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--text);
      margin-bottom: 0.45rem;
    }

    .cell-desc {
      font-size: 0.875rem;
      color: var(--text-muted);
      line-height: 1.58;
      margin-bottom: 1rem;
      flex: 1;
    }

    .cell-desc code {
      font-family: var(--font-mono);
      font-size: 0.8em;
      color: var(--brand-bright);
      background: var(--brand-surface);
      padding: 0.08rem 0.35rem;
      border-radius: 2px;
    }

    .cell-callout {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-muted);
      border-left: 2px solid var(--brand);
      padding-left: 0.65rem;
      line-height: 1.45;
      transition: color 0.2s, border-color 0.2s;
    }

    .matrix-cell:hover .cell-callout {
      color: var(--text);
      border-left-color: var(--brand-bright);
    }

    /* ────────────────────────────────────────
       STAGE 1: STATE RECOVERY (CHECKPOINT REPLAY)
    ──────────────────────────────────────── */
    .stage-replay {
      gap: 0.55rem;
      font-family: var(--font-mono);
      font-size: 0.7rem;
    }

    .replay-track {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.35rem;
      align-items: center;
    }

    .r-node {
      border: 1px solid var(--border);
      background: var(--bg-panel);
      border-radius: 3px;
      padding: 0.4rem 0.45rem;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      position: relative;
      overflow: hidden;
    }

    .r-node .r-id {
      font-size: 0.6rem;
      color: var(--text-faint);
    }

    .r-node .r-lbl {
      font-size: 0.66rem;
      color: var(--text);
      font-weight: 500;
    }

    .r-node.cached {
      border-color: oklch(73% 0.16 156 / 0.35);
      background: oklch(18% 0.04 156 / 0.35);
    }
    .r-node.cached .r-id { color: var(--emerald); }

    .r-node.fault {
      border-color: oklch(65% 0.20 25 / 0.45);
      animation: fault-recover 6s var(--ease-out) infinite;
    }

    .r-node.resume {
      border-color: oklch(66% 0.22 282 / 0.35);
      animation: resume-step 6s var(--ease-out) infinite;
    }

    .replay-bar {
      height: 2px;
      background: var(--border);
      position: relative;
      overflow: hidden;
      border-radius: 1px;
    }

    .replay-beam {
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, var(--emerald), var(--brand-bright));
      transform-origin: left center;
      transform: scaleX(0);
      animation: replay-sweep 6s var(--ease-out) infinite;
    }

    .replay-log {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.66rem;
      color: var(--text-faint);
    }

    .replay-log .hl {
      color: var(--emerald);
      animation: pulse-opacity 6s ease-in-out infinite;
    }

    @keyframes fault-recover {
      0%, 22%   { border-color: oklch(65% 0.20 25 / 0.7); background: var(--crimson-dim); }
      38%, 100% { border-color: oklch(73% 0.16 156 / 0.45); background: oklch(18% 0.04 156 / 0.35); }
    }

    @keyframes resume-step {
      0%, 42%   { opacity: 0.45; border-color: var(--border); background: var(--bg-panel); }
      55%, 100% { opacity: 1; border-color: oklch(73% 0.16 156 / 0.45); background: oklch(18% 0.04 156 / 0.35); }
    }

    @keyframes replay-sweep {
      0%        { transform: scaleX(0.48); opacity: 0.5; }
      25%       { transform: scaleX(0.50); opacity: 0.9; }
      65%, 90%  { transform: scaleX(1); opacity: 1; }
      100%      { transform: scaleX(0.48); opacity: 0.5; }
    }

    @keyframes pulse-opacity {
      0%, 28%   { opacity: 0.4; }
      45%, 90%  { opacity: 1; }
      100%      { opacity: 0.4; }
    }

    /* ────────────────────────────────────────
       STAGE 2: SMART RETRIES (LOGARITHMIC BACKOFF)
    ──────────────────────────────────────── */
    .stage-retries {
      gap: 0.65rem;
      font-family: var(--font-mono);
    }

    .backoff-bars {
      display: grid;
      grid-template-columns: 1fr 1.5fr 2.4fr 1.2fr;
      gap: 0.4rem;
      align-items: end;
      height: 66px;
    }

    .b-col {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      height: 100%;
      justify-content: flex-end;
    }

    .b-meter {
      height: 28px;
      border: 1px solid var(--border);
      background: var(--bg-panel);
      border-radius: 2px;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.62rem;
      color: var(--text-muted);
    }

    .b-col:nth-child(1) .b-meter { animation: retry-slot-1 6.4s ease-out infinite; }
    .b-col:nth-child(2) .b-meter { animation: retry-slot-2 6.4s ease-out infinite; }
    .b-col:nth-child(3) .b-meter { animation: retry-slot-3 6.4s ease-out infinite; }
    .b-col:nth-child(4) .b-meter { animation: retry-slot-4 6.4s ease-out infinite; }

    .b-cap {
      font-size: 0.62rem;
      color: var(--text-faint);
      display: flex;
      justify-content: space-between;
    }

    .backoff-axis {
      display: flex;
      justify-content: space-between;
      font-size: 0.64rem;
      color: var(--text-faint);
      border-top: 1px solid var(--border);
      padding-top: 0.4rem;
    }

    @keyframes retry-slot-1 {
      0%, 15%   { border-color: var(--crimson); color: var(--crimson); background: var(--crimson-dim); }
      25%, 100% { border-color: var(--border); color: var(--text-faint); background: var(--bg-panel); }
    }
    @keyframes retry-slot-2 {
      0%, 18%   { border-color: var(--border); color: var(--text-faint); }
      24%, 40%  { border-color: var(--amber); color: var(--amber); background: var(--amber-dim); }
      50%, 100% { border-color: var(--border); color: var(--text-faint); background: var(--bg-panel); }
    }
    @keyframes retry-slot-3 {
      0%, 42%   { border-color: var(--border); color: var(--text-faint); }
      48%, 65%  { border-color: var(--amber); color: var(--amber); background: var(--amber-dim); }
      75%, 100% { border-color: var(--border); color: var(--text-faint); background: var(--bg-panel); }
    }
    @keyframes retry-slot-4 {
      0%, 66%   { border-color: var(--border); color: var(--text-faint); background: var(--bg-panel); }
      72%, 94%  { border-color: var(--emerald); color: var(--emerald); background: var(--emerald-dim); }
      100%      { border-color: var(--border); color: var(--text-faint); background: var(--bg-panel); }
    }

    /* ────────────────────────────────────────
       STAGE 3: CONCURRENT WORKERS (SKIP LOCKED)
    ──────────────────────────────────────── */
    .stage-workers {
      gap: 0.42rem;
      font-family: var(--font-mono);
    }

    .worker-lane {
      display: grid;
      grid-template-columns: 58px 1fr 74px;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.66rem;
    }

    .w-name {
      color: var(--text-muted);
    }

    .w-rail {
      height: 22px;
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: 2px;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      padding: 0 4px;
      container-type: inline-size;
    }

    .w-job {
      height: 14px;
      width: 58px;
      border-radius: 2px;
      background: var(--brand-surface);
      border: 1px solid oklch(66% 0.22 282 / 0.55);
      color: var(--brand-bright);
      font-size: 0.6rem;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: worker-slide 4.5s var(--ease-out) infinite;
    }

    .worker-lane:nth-child(2) .w-job { animation-delay: 0.55s; }
    .worker-lane:nth-child(3) .w-job { animation-delay: 1.1s; }

    .w-state {
      text-align: right;
      font-size: 0.62rem;
      color: var(--emerald);
    }

    @keyframes worker-slide {
      0%   { transform: translateX(-8px); opacity: 0; }
      18%  { transform: translateX(0); opacity: 1; }
      75%  { transform: translateX(calc(100cqw - 66px)); opacity: 1; }
      92%  { transform: translateX(calc(100cqw - 54px)); opacity: 0; }
      100% { transform: translateX(-8px); opacity: 0; }
    }

    /* ────────────────────────────────────────
       STAGE 4: TIMEOUTS & DEADLINES
    ──────────────────────────────────────── */
    .stage-timeout {
      gap: 0.65rem;
      font-family: var(--font-mono);
    }

    .timeout-meta {
      display: flex;
      justify-content: space-between;
      font-size: 0.66rem;
      color: var(--text-muted);
    }

    .timeout-meta .cap { color: var(--crimson); }

    .timeout-rail {
      height: 16px;
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: 2px;
      position: relative;
      overflow: hidden;
    }

    .timeout-threshold {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 72%;
      width: 1px;
      background: var(--crimson);
      z-index: 2;
    }

    .timeout-fill {
      position: absolute;
      inset: 2px;
      right: 28%;
      background: linear-gradient(90deg, var(--brand), var(--crimson));
      transform-origin: left center;
      animation: deadline-fill 5.5s linear infinite;
      border-radius: 1px;
    }

    .timeout-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.65rem;
      color: var(--text-faint);
    }

    .timeout-badge {
      padding: 0.12rem 0.4rem;
      border-radius: 2px;
      border: 1px solid oklch(65% 0.20 25 / 0.45);
      background: var(--crimson-dim);
      color: var(--crimson);
      animation: cancel-flash 5.5s linear infinite;
    }

    @keyframes deadline-fill {
      0%        { transform: scaleX(0.08); opacity: 0.9; }
      68%       { transform: scaleX(1); opacity: 1; }
      85%, 100% { transform: scaleX(1); opacity: 0.25; }
    }

    @keyframes cancel-flash {
      0%, 64%   { opacity: 0.35; }
      70%, 95%  { opacity: 1; }
      100%      { opacity: 0.35; }
    }

    /* ────────────────────────────────────────
       STAGE 5: IDEMPOTENCY BUILT-IN
    ──────────────────────────────────────── */
    .stage-idempotency {
      gap: 0.5rem;
      font-family: var(--font-mono);
    }

    .idem-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.66rem;
    }

    .idem-req {
      padding: 0.38rem 0.55rem;
      border: 1px solid var(--border);
      background: var(--bg-panel);
      border-radius: 2px;
      color: var(--text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .idem-gate {
      padding: 0.25rem 0.45rem;
      border-radius: 2px;
      font-size: 0.62rem;
      border: 1px solid var(--border-strong);
      color: var(--text-muted);
      background: var(--bg-elevated);
    }

    .idem-res {
      padding: 0.38rem 0.55rem;
      border-radius: 2px;
      text-align: center;
      font-size: 0.64rem;
    }

    .idem-res.exec {
      border: 1px solid oklch(73% 0.16 156 / 0.45);
      background: var(--emerald-dim);
      color: var(--emerald);
      animation: idem-pass 5s ease-in-out infinite;
    }

    .idem-res.dedup {
      border: 1px solid oklch(66% 0.22 282 / 0.45);
      background: var(--brand-surface);
      color: var(--brand-bright);
      animation: idem-block 5s ease-in-out infinite;
    }

    @keyframes idem-pass {
      0%, 15%   { opacity: 0.55; }
      25%, 90%  { opacity: 1; }
      100%      { opacity: 0.55; }
    }
    @keyframes idem-block {
      0%, 45%   { opacity: 0.35; transform: translateX(-3px); }
      58%, 92%  { opacity: 1; transform: translateX(0); }
      100%      { opacity: 0.35; transform: translateX(-3px); }
    }

    /* ────────────────────────────────────────
       STAGE 6: EVENTS & ASYNC WAITS
    ──────────────────────────────────────── */
    .stage-events {
      gap: 0.55rem;
      font-family: var(--font-mono);
    }

    .event-chain {
      display: grid;
      grid-template-columns: 1fr 1.25fr 1fr;
      gap: 0.45rem;
      align-items: center;
    }

    .ev-box {
      border: 1px solid var(--border);
      background: var(--bg-panel);
      border-radius: 2px;
      padding: 0.45rem 0.5rem;
      text-align: center;
      font-size: 0.65rem;
      color: var(--text-muted);
    }

    .ev-box.wait {
      border-color: oklch(78% 0.15 72 / 0.45);
      color: var(--amber);
      background: var(--amber-dim);
      animation: wait-state 6s ease-in-out infinite;
    }

    .ev-box.resumed {
      animation: resume-glow 6s ease-in-out infinite;
    }

    .ev-webhook {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border: 1px dashed var(--border-strong);
      border-radius: 2px;
      padding: 0.36rem 0.6rem;
      font-size: 0.64rem;
      color: var(--text-muted);
      animation: webhook-fire 6s ease-in-out infinite;
    }

    .ev-webhook span:last-child { color: var(--brand-bright); }

    @keyframes wait-state {
      0%, 52%   { border-color: oklch(78% 0.15 72 / 0.55); color: var(--amber); background: var(--amber-dim); }
      64%, 92%  { border-color: oklch(73% 0.16 156 / 0.45); color: var(--emerald); background: var(--emerald-dim); }
      100%      { border-color: oklch(78% 0.15 72 / 0.55); color: var(--amber); background: var(--amber-dim); }
    }

    @keyframes webhook-fire {
      0%, 44%   { opacity: 0.45; border-color: var(--border); }
      52%, 75%  { opacity: 1; border-color: var(--brand); background: var(--brand-surface); }
      90%, 100% { opacity: 0.45; border-color: var(--border); background: transparent; }
    }

    @keyframes resume-glow {
      0%, 58%   { opacity: 0.4; border-color: var(--border); color: var(--text-faint); }
      68%, 92%  { opacity: 1; border-color: oklch(73% 0.16 156 / 0.5); color: var(--emerald); background: var(--emerald-dim); }
      100%      { opacity: 0.4; border-color: var(--border); color: var(--text-faint); }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* ────────────────────────────────────────
       CODE SECTION / TWO APIS
    ──────────────────────────────────────── */
    .code-section {
      padding: 5.5rem 0;
      border-top: 1px solid var(--border);
    }

    .code-shell {
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      overflow: hidden;
      background: var(--bg-code);
    }

    .tab-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--bg-panel);
      border-bottom: 1px solid var(--border);
      padding: 0 1rem;
      gap: 1rem;
    }

    .tab-list {
      display: flex;
      list-style: none;
      gap: 0.25rem;
    }

    .tab-btn {
      background: transparent;
      border: none;
      border-bottom: 2px solid transparent;
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-weight: 500;
      padding: 0.8rem 0.95rem;
      cursor: pointer;
      transition: color 0.15s, border-color 0.15s;
      margin-bottom: -1px;
    }

    .tab-btn:hover { color: var(--text); }
    .tab-btn.active {
      color: var(--text);
      border-bottom-color: var(--brand-bright);
    }

    .tab-hint {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--text-faint);
    }

    @media (max-width: 600px) {
      .tab-hint { display: none; }
    }

    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    .tab-panel pre {
      padding: 1.4rem 1.5rem;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      line-height: 1.7;
      overflow-x: auto;
    }

    /* ────────────────────────────────────────
       CTA SECTION
    ──────────────────────────────────────── */
    .cta-section {
      padding: 5.5rem 0;
      border-top: 1px solid var(--border);
      background: var(--bg-panel);
      position: relative;
      overflow: hidden;
    }

    .cta-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
    }

    .cta-copy h2 {
      font-family: var(--font-display);
      font-size: clamp(1.85rem, 3.2vw, 2.5rem);
      font-weight: 700;
      letter-spacing: -0.035em;
      margin-bottom: 0.6rem;
    }

    .cta-copy p {
      color: var(--text-muted);
      max-width: 48ch;
      font-size: 1rem;
    }

    .cta-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    /* ────────────────────────────────────────
       FOOTER
    ──────────────────────────────────────── */
    footer {
      border-top: 1px solid var(--border);
      padding: 2.5rem 0;
      background: var(--bg);
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .footer-logo {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      text-decoration: none;
      color: var(--text);
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 0.92rem;
    }

    .footer-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      list-style: none;
      flex-wrap: wrap;
    }

    .footer-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.84rem;
      transition: color 0.15s;
    }

    .footer-links a:hover { color: var(--text); }

    .footer-copy {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      color: var(--text-faint);
    }

    /* Mobile spacing refinements */
    @media (max-width: 640px) {
      .section { padding: 4rem 0; }
      .code-section { padding: 4rem 0; }
      .cta-section { padding: 4rem 0; }
      .hero-actions { width: 100%; }
      .hero-actions .btn { flex: 1; justify-content: center; }
      .hero-code-variant pre,
      .tab-panel pre { font-size: 0.75rem; padding: 1rem; }
      .install-bar { width: 100%; justify-content: space-between; }
    }
  </style>
</head>
